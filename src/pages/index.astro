---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { encodeHrefSegment, getVisiblePosts } from '../lib/blog';

// 取前 6 篇可见文章
const posts = getVisiblePosts(await getCollection('blog')).slice(0, 6);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- Hero Section -->
	<header class="hero animate-fade-up" style="--delay: 1">
		<h1 class="hero__title">{SITE_TITLE}</h1>
		<p class="hero__subtitle">
			欢迎来到我的博客。这里记录着我的一些经验与日常。
			<span class="hero__cursor"></span>
		</p>
		<div class="cta-group">
			<a href="/posts/" class="btn btn--primary">探索文章</a>
			<a href="/about/" class="btn btn--secondary">关于我</a>
		</div>
	</header>

	<!-- Main Home Content: Recent Posts -->
	<section class="home-content" aria-labelledby="recent-posts">
		<h2 id="recent-posts" class="animate-fade-up" style="--delay: 2">最新文章</h2>
		<ul class="post-list">
			{
				posts.map((post, index) => (
					<li class="post-card animate-fade-up" style={`--delay: ${index + 3}`}>
						<h3>
							<a href={`/posts/${post.id}/`}>{post.data.title}</a>
						</h3>
						<p class="post-meta">
							<FormattedDate date={post.data.pubDate} />
							{
								post.data.updatedDate && (
									<span class="post-meta-updated">
										· 更新于 <FormattedDate date={post.data.updatedDate} />
									</span>
								)
							}
						</p>
						{
							(post.data.categories.length > 0 || post.data.tags.length > 0) && (
								<div class="post-taxonomy">
									{post.data.categories.map((category) => (
										<a href={`/categories/${encodeHrefSegment(category)}/`}>{category}</a>
									))}
									{post.data.tags.map((tag) => (
										<a href={`/tags/${encodeHrefSegment(tag)}/`}>#{tag}</a>
									))}
								</div>
							)
						}
						<p>{post.data.description}</p>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	/* Hero Section */
	.hero {
		padding: 3.5rem 0 3rem;
		text-align: left;
		position: relative;
	}
	.hero__title {
		font-size: 3.5rem;
		font-weight: 800;
		line-height: 1.15;
		margin: 0 0 1.25rem;
		background: linear-gradient(135deg, var(--accent) 0%, var(--accent-secondary) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		letter-spacing: -0.03em;
		transition: color var(--transition-normal);
	}
	.hero__subtitle {
		font-size: 1.35rem;
		color: var(--text-muted);
		max-width: 680px;
		margin: 0 0 2.25rem;
		line-height: 1.65;
		transition: color var(--transition-normal);
	}
	.hero__cursor {
		display: inline-block;
		width: 3px;
		height: 1.1em;
		background-color: var(--accent);
		margin-left: 4px;
		vertical-align: middle;
		animation: blink 1s step-end infinite;
	}
	
	/* Call To Action Buttons */
	.cta-group {
		display: flex;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.65rem;
		border-radius: 12px;
		font-weight: 600;
		text-decoration: none;
		transition: transform var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
	}
	.btn--primary {
		background: var(--accent);
		color: #ffffff;
		box-shadow: 0 4px 14px rgba(124, 58, 237, 0.28);
	}
	.btn--primary:hover {
		background: var(--accent-dark);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(124, 58, 237, 0.4);
	}
	.btn--secondary {
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text);
	}
	.btn--secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-2px);
		background: var(--surface-muted);
	}
	
	.home-content {
		margin-top: 2rem;
	}
	
	.post-card a {
		color: var(--text-strong);
		transition: color var(--transition-fast);
	}
	.post-card a:hover {
		color: var(--accent);
	}

	/* Blinking Cursor Animation */
	@keyframes blink {
		from, to { background-color: transparent }
		50% { background-color: var(--accent) }
	}
	
	@media (max-width: 768px) {
		.hero {
			padding: 2.5rem 0 2rem;
		}
		.hero__title {
			font-size: 2.75rem;
		}
	}
</style>
