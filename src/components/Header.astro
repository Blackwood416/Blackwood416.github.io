---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const links = [
	{ href: '/posts/', label: '文章' },
	{ href: '/news/', label: '快讯' },
	{ href: '/archives/', label: '归档' },
	{ href: '/tags/', label: '标签' },
	{ href: '/categories/', label: '分类' },
	{ href: '/tools/', label: '工具' },
	{ href: '/search/', label: '搜索' },
	{ href: '/about/', label: '关于' },
];
---

<header class="site-header">
	<nav class="nav-pill">
		<h2 class="brand">
			<a href="/" class="brand__link">
				<span class="brand__sparkle" aria-hidden="true">✦</span>
				<span class="brand__text">{SITE_TITLE}</span>
			</a>
		</h2>
		<div class="internal-links">
			{links.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
			<button id="theme-toggle" class="theme-toggle" aria-label="切换主题" title="切换主题">
				<svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="12" r="5"></circle>
					<line x1="12" y1="1" x2="12" y2="3"></line>
					<line x1="12" y1="21" x2="12" y2="23"></line>
					<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
					<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
					<line x1="1" y1="12" x2="3" y2="12"></line>
					<line x1="21" y1="12" x2="23" y2="12"></line>
					<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
					<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
				</svg>
				<svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<script>
	const themeToggle = document.getElementById('theme-toggle');
	
	themeToggle?.addEventListener('click', () => {
		const isDark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
		
		// 派发自定义事件，供其他需要响应主题改变的组件（如 Pagefind 搜索组件）使用
		const event = new CustomEvent('theme-change', { detail: { theme: isDark ? 'dark' : 'light' } });
		document.dispatchEvent(event);
	});
</script>

<style>
	.site-header {
		margin: 0;
		padding: 0.85rem 1rem 0.25rem;
		position: sticky;
		top: 0;
		z-index: 100;
		pointer-events: none;
	}

	.nav-pill {
		pointer-events: auto;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 0.65rem 1.25rem;
		border-radius: 9999px;
		background: var(--nav-bg);
		border: 1px solid var(--glass-border);
		backdrop-filter: url(#liquid-glass) blur(28px) saturate(190%);
		-webkit-backdrop-filter: url(#liquid-glass) blur(28px) saturate(190%);
		box-shadow: var(--glass-shadow), 0 12px 32px -8px rgba(124, 58, 237, 0.1);
		transition: background-color var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal), transform var(--transition-normal);
		overflow: hidden;
	}

	/* 胶囊顶部流光高光细线（纯净银紫镜面高光） */
	.nav-pill::before {
		content: '';
		position: absolute;
		top: 0;
		left: 14%;
		right: 14%;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(167, 139, 250, 0.45), rgba(255, 255, 255, 0.55), rgba(167, 139, 250, 0.45), transparent);
		pointer-events: none;
	}

	.brand {
		margin: 0;
		font-size: 1.08rem;
		letter-spacing: -0.01em;
	}

	.brand__link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		text-decoration: none;
		font-weight: 800;
		color: var(--text-strong);
		transition: transform var(--transition-fast);
	}

	.brand__link:hover {
		transform: translateY(-1px);
	}

	.brand__sparkle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 1rem;
		background: var(--gradient-aurora);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		filter: drop-shadow(0 0 8px rgba(124, 58, 237, 0.45));
		animation: sparkleSpin 6s ease-in-out infinite;
	}

	.brand__text {
		background: linear-gradient(135deg, var(--text-strong) 20%, var(--accent) 85%, var(--accent-secondary) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	@keyframes sparkleSpin {
		0%, 100% { transform: scale(1) rotate(0deg); }
		50% { transform: scale(1.18) rotate(18deg); }
	}

	nav a {
		color: var(--text);
		text-decoration: none;
		font-size: 0.94rem;
		font-weight: 500;
		transition: color var(--transition-fast), background-color var(--transition-fast);
	}

	.internal-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		align-items: center;
		justify-content: flex-end;
	}

	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: rgba(124, 58, 237, 0.08);
		border: 1px solid var(--glass-border);
		border-radius: 9999px;
		width: 34px;
		height: 34px;
		padding: 0;
		cursor: pointer;
		color: var(--accent);
		margin-left: 0.35rem;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
		transition: border-color var(--transition-fast), color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-normal), box-shadow var(--transition-fast);
	}

	.theme-toggle:hover {
		border-color: var(--accent);
		background: var(--accent);
		color: #ffffff;
		transform: rotate(15deg) scale(1.08);
		box-shadow: 0 0 16px rgba(124, 58, 237, 0.45);
	}

	.theme-toggle:active {
		transform: scale(0.95);
	}

	.sun-icon {
		display: block;
	}

	.moon-icon {
		display: none;
	}

	:global(.dark) .sun-icon {
		display: none;
	}

	:global(.dark) .moon-icon {
		display: block;
	}

	@media (max-width: 780px) {
		.site-header {
			padding: 0.5rem 0.75rem 0;
		}
		.nav-pill {
			border-radius: 20px;
			padding: 0.75rem 1rem;
			align-items: stretch;
			flex-direction: column;
			gap: 0.6rem;
		}
		.internal-links {
			justify-content: space-between;
			width: 100%;
			gap: 0.25rem;
		}
		.theme-toggle {
			margin-left: auto;
		}
	}
</style>
