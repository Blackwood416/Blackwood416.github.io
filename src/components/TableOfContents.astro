---
import type { TocHeading } from '../lib/blog';

interface Props {
	items: TocHeading[];
	variant?: 'desktop' | 'mobile' | 'both';
}

const { items, variant = 'both' } = Astro.props;
const showDesktop = variant === 'desktop' || variant === 'both';
const showMobile = variant === 'mobile' || variant === 'both';
---

{
	items.length > 0 && (
		<>
			{showDesktop && (
				<aside class="toc toc--desktop" aria-label="文章目录">
					<p class="toc__title">目录</p>
					<nav>
						<ul>
							{items.map((item) => (
								<li class={`toc__item toc__item--depth-${item.depth}`}>
									<a href={`#${item.slug}`}>{item.text}</a>
								</li>
							))}
						</ul>
					</nav>
				</aside>
			)}
			{showMobile && (
				<details class="toc toc--mobile">
					<summary>目录</summary>
					<nav aria-label="文章目录">
						<ul>
							{items.map((item) => (
								<li class={`toc__item toc__item--depth-${item.depth}`}>
									<a href={`#${item.slug}`}>{item.text}</a>
								</li>
							))}
						</ul>
					</nav>
				</details>
			)}
		</>
	)
}
